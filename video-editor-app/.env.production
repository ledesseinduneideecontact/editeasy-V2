# Production Configuration for Ubuntu VPS

# Backend Configuration
PORT=3000
NODE_ENV=production

# AI Service (Docker internal network)
AI_SERVICE_URL=http://ai-processor:5000

# File Upload Limits (increase for production)
MAX_FILE_SIZE=1073741824
MAX_FILES=200

# Paths (Docker volumes)
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs
TEMP_DIR=/app/temp

# FFmpeg Settings (optimize for VPS)
FFMPEG_THREADS=0

# Security (set in your actual deployment)
# ALLOWED_ORIGINS=https://yourdomain.com
